# Copy this file to `.env.local` and fill in the real values.

# Address of the One Base backend, reachable from the machine running Next.js.
# Server-side only — never prefix with NEXT_PUBLIC_, that would ship it to the browser.
# Restart `npm run dev` after changing it: it is read once at startup.
BACKEND_URL=http://<host>:<port>

# Login for /site-map (the list of every page), HTTP Basic like Swagger.
# Not set = the site map is closed to everyone.
SITEMAP_USERNAME=onebase
SITEMAP_PASSWORD=<choose one>
